<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <OutputType>Library</OutputType>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AutoCadSdkPath Condition="'$(AutoCadSdkPath)' == '' And Exists('C:\Program Files\Autodesk\AutoCAD 2026\acmgd.dll')">C:\Program Files\Autodesk\AutoCAD 2026</AutoCadSdkPath>
    <AutoCadSdkPath Condition="'$(AutoCadSdkPath)' == '' And Exists('D:\Program Files\Autodesk\AutoCAD 2026\acmgd.dll')">D:\Program Files\Autodesk\AutoCAD 2026</AutoCadSdkPath>
    <UseAutoCadNuGet Condition="'$(UseAutoCadNuGet)' == '' And !Exists('$(AutoCadSdkPath)\acmgd.dll')">true</UseAutoCadNuGet>
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" />
    <PackageReference Condition="'$(UseAutoCadNuGet)' == 'true'" Include="AutoCAD.NET" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\CadArchSpec.Host.Shared\CadDrawingExchange.cs" Link="CadDrawingExchange.cs" />
    <ProjectReference Include="..\CadArchSpec.Host.Contracts\CadArchSpec.Host.Contracts.csproj" />
    <ProjectReference Include="..\CadArchSpec.EditorBridge\CadArchSpec.EditorBridge.csproj" />
    <ProjectReference Include="..\CadArchSpec.RuleEngine\CadArchSpec.RuleEngine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\CadArchSpec.Editor.Web\dist\**\*">
      <Link>Web\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\rules\CN\common\package.json">
      <Link>Rules\CN\common\package.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup Condition="'$(UseAutoCadNuGet)' != 'true'">
    <Reference Include="acmgd">
      <HintPath>$(AutoCadSdkPath)\acmgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="acdbmgd">
      <HintPath>$(AutoCadSdkPath)\acdbmgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="accoremgd">
      <HintPath>$(AutoCadSdkPath)\accoremgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateAutoCadSdk" BeforeTargets="ResolveReferences">
    <Error
      Condition="'$(UseAutoCadNuGet)' != 'true' And (!Exists('$(AutoCadSdkPath)\acmgd.dll') Or !Exists('$(AutoCadSdkPath)\acdbmgd.dll') Or !Exists('$(AutoCadSdkPath)\accoremgd.dll'))"
      Text="未找到 AutoCAD 2026 托管 SDK。请通过 /p:AutoCadSdkPath=... 指定包含 acmgd.dll、acdbmgd.dll、accoremgd.dll 的目录。" />
  </Target>
</Project>
