<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Wanluo.StandaloneWorkbench">
  <SolidColorBrush x:Key="CanvasBrush" Color="#282F38"/>
  <SolidColorBrush x:Key="PanelBrush" Color="#303945"/>
  <SolidColorBrush x:Key="BorderBrush" Color="#495361"/>
  <SolidColorBrush x:Key="TextBrush" Color="#E2E8EF"/>
  <SolidColorBrush x:Key="MutedBrush" Color="#AEBBC9"/>
  <Style TargetType="local:CadIconButton">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="5,2"/><Setter Property="Margin" Value="1"/><Setter Property="MinHeight" Value="26"/>
    <Setter Property="Cursor" Value="Hand"/><Setter Property="Focusable" Value="False"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:CadIconButton">
      <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="2" Padding="{TemplateBinding Padding}">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
          <local:CadIcon Glyph="{TemplateBinding Icon}" Width="18" Height="18"/>
          <TextBlock x:Name="Label" Text="{TemplateBinding Label}" Margin="5,0,0,0"/>
          <TextBlock x:Name="Shortcut" Text="{TemplateBinding Shortcut}" Margin="4,0,0,0" Foreground="#ACCEEB" FontSize="10"/>
        </StackPanel>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="#4D6076"/><Setter TargetName="Face" Property="BorderBrush" Value="#79B6E9"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Background" Value="#236391"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
        <Trigger Property="Label" Value=""><Setter TargetName="Label" Property="Visibility" Value="Collapsed"/></Trigger>
        <Trigger Property="Shortcut" Value=""><Setter TargetName="Shortcut" Property="Visibility" Value="Collapsed"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="CadRibbonButton" TargetType="local:CadIconButton" BasedOn="{StaticResource {x:Type local:CadIconButton}}">
    <Setter Property="Width" Value="54"/><Setter Property="Height" Value="57"/><Setter Property="Padding" Value="2"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:CadIconButton">
      <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="2" Padding="{TemplateBinding Padding}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <local:CadIcon Glyph="{TemplateBinding Icon}" Width="28" Height="28" Margin="0,0,0,4"/>
          <TextBlock Text="{TemplateBinding Label}" HorizontalAlignment="Center" FontSize="12"/>
        </StackPanel>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="#4D6076"/><Setter TargetName="Face" Property="BorderBrush" Value="#79B6E9"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Background" Value="#236391"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="CadTabs" TargetType="TabControl">
    <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="#404F63"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl">
      <Grid><Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TabPanel IsItemsHost="True" Background="#303945"/>
        <Border x:Name="Body" Grid.Row="1" Background="{TemplateBinding Background}"><ContentPresenter ContentSource="SelectedContent"/></Border>
      </Grid>
      <ControlTemplate.Triggers><Trigger Property="Tag" Value="Collapsed"><Setter TargetName="Body" Property="Visibility" Value="Collapsed"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="CadTab" TargetType="TabItem">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Padding" Value="12,3"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
      <Border x:Name="Face" Padding="{TemplateBinding Padding}" Background="Transparent"><ContentPresenter ContentSource="Header" VerticalAlignment="Center"/></Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Face" Property="Background" Value="#405C78"/><Setter Property="Foreground" Value="#8ACDFF"/></Trigger>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="#48586A"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="CadStrip" TargetType="ListBox">
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Background" Value="#303945"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden"/><Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></Setter.Value></Setter>
    <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="#D9E1E9"/><Setter Property="Padding" Value="12,3"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="Face" Background="Transparent" BorderBrush="#45505E" BorderThickness="0,0,1,0" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Face" Property="Background" Value="#405E7D"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="#48586A"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style></Setter.Value></Setter>
  </Style>
  <Style x:Key="CadMenu" TargetType="Menu">
    <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Style.Resources>
      <Style TargetType="MenuItem"><Setter Property="Background" Value="#303945"/><Setter Property="Foreground" Value="#E2E8EF"/><Setter Property="Padding" Value="8,4"/></Style>
    </Style.Resources>
  </Style>
  <Style x:Key="CadStatusToggle" TargetType="CheckBox">
    <Setter Property="Foreground" Value="#BCCAD8"/><Setter Property="Padding" Value="5,3"/><Setter Property="Margin" Value="1,0"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
      <Border x:Name="Face" Background="Transparent" Padding="{TemplateBinding Padding}" BorderBrush="#4A5666" BorderThickness="0,0,1,0"><ContentPresenter VerticalAlignment="Center"/></Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Face" Property="Background" Value="#34688F"/><Setter Property="Foreground" Value="White"/></Trigger>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="#485A6F"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="CadComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
      <Grid>
        <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}">
          <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#2C3643" BorderBrush="#59697C" BorderThickness="1"><local:CadIcon Glyph="chevron-down" Width="12" Height="12" HorizontalAlignment="Right" Margin="0,0,6,0"/></Border></ControlTemplate></ToggleButton.Template>
        </ToggleButton>
        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" Margin="7,1,25,1" VerticalAlignment="Center" IsHitTestVisible="False"/>
        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
          <Border Background="#303945" BorderBrush="#59697C" BorderThickness="1" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="300"><ScrollViewer><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border>
        </Popup>
      </Grid>
      <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
