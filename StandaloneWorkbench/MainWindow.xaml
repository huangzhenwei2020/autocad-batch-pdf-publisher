<Window x:Class="Wanluo.StandaloneWorkbench.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Wanluo.StandaloneWorkbench" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="万落独立工作台" Width="1440" Height="900" MinWidth="980" MinHeight="640" WindowStartupLocation="CenterScreen" WindowStyle="None" Style="{DynamicResource {x:Type Window}}">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="30" CornerRadius="0" ResizeBorderThickness="5" GlassFrameThickness="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
  <Grid Margin="0" Background="#303945">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <DockPanel Height="30" Margin="3,0" LastChildFill="True">
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" shell:WindowChrome.IsHitTestVisibleInChrome="True">
        <local:CadIcon Glyph="brand" Width="19" Height="19" Margin="4,0"/>
        <Menu Style="{StaticResource CadMenu}" VerticalAlignment="Center">
          <MenuItem Header="文件">
            <MenuItem x:Name="NewDrawingFileMenu" Header="新建图纸" InputGestureText="Ctrl+N" Click="NewDrawing_Click"/>
            <MenuItem Header="打开图纸…" InputGestureText="Ctrl+O" Click="OpenDrawing_Click"/>
            <MenuItem Header="保存图纸" InputGestureText="Ctrl+S" Click="SaveDrawing_Click"/>
            <MenuItem Header="另存图纸…" InputGestureText="Ctrl+Shift+S" Click="SaveDrawingAs_Click"/>
            <MenuItem Header="关闭当前图纸" Click="CloseDrawing_Click"/>
            <Separator/>
            <MenuItem Header="新建项目…" Click="NewProject_Click"/><MenuItem Header="打开项目…" Click="OpenProject_Click"/>
            <MenuItem Header="新建建筑模型…" Click="NewModel_Click"/><MenuItem Header="打开模型文件…" Click="OpenModel_Click"/>
          </MenuItem>
          <MenuItem Header="工作区"><MenuItem Header="二维绘图" Click="DrawingWorkspace_Click"/><MenuItem Header="模型与楼层" Click="ModelWorkspace_Click"/><MenuItem Header="项目浏览器" Click="ProjectPanel_Click"/><MenuItem Header="清屏绘图" InputGestureText="Ctrl+0" Click="CleanScreen_Click"/></MenuItem>
        </Menu>
        <local:CadIconButton x:Name="NewDrawingQuickAccess" Icon="file-plus" Click="NewDrawing_Click" ToolTip="新建图纸 Ctrl+N"/>
        <local:CadIconButton Icon="folder-open" Click="OpenDrawing_Click" ToolTip="打开图纸 Ctrl+O"/>
        <local:CadIconButton Icon="save" Click="SaveActive_Click" ToolTip="保存 Ctrl+S"/>
        <local:CadIconButton Icon="undo-2" Tag="@undo" Click="QuickCommand_Click" ToolTip="撤销 Ctrl+Z"/>
        <local:CadIconButton Icon="redo-2" Tag="@redo" Click="QuickCommand_Click" ToolTip="重做 Ctrl+Y"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
        <local:CadIconButton Icon="minus" Click="Minimize_Click" ToolTip="最小化" Width="30"/>
        <local:CadIconButton x:Name="MaximizeButton" Icon="square" Click="Maximize_Click" ToolTip="最大化／还原" Width="30"/>
        <local:CadIconButton Icon="x" Click="CloseWindow_Click" ToolTip="关闭窗口" Width="30"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
        <TextBlock Text="项目" FontSize="12" Margin="8,0,2,0"/>
        <ComboBox x:Name="Projects" Width="175" MinHeight="24" Height="24" FontSize="12" Margin="2" Padding="5,0" DisplayMemberPath="Name" SelectionChanged="Projects_Changed" Style="{StaticResource CadComboBox}"/>
        <local:CadIconButton Icon="slash" Label="二维绘图" Click="DrawingWorkspace_Click"/>
        <local:CadIconButton Icon="box" Label="三维建模" Click="StudioWorkspace_Click"/>
        <local:CadIconButton Icon="layers" Label="模型管理" Click="ModelWorkspace_Click"/>
        <local:CadIconButton Icon="app-window" Label="AutoCAD／天正" Click="Cad_Click"/>
      </StackPanel>
      <TextBlock x:Name="CaptionTitle" Text="{Binding Title,RelativeSource={RelativeSource AncestorType=Window}}" TextTrimming="CharacterEllipsis" Margin="10,0" FontSize="12"/>
    </DockPanel>
    <TextBlock x:Name="ProjectLocation" Visibility="Collapsed"/>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="28" />
        <ColumnDefinition x:Name="ProjectColumn" Width="0" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <StackPanel Background="#303945">
        <local:CadIconButton Icon="panel-left" Click="ProjectPanel_Click" ToolTip="显示／收起项目浏览器" Padding="3,5"/>
        <local:CadIconButton Icon="folder-open" Click="ProjectPanel_Click" ToolTip="项目图纸" Padding="3,5"/>
        <local:CadIconButton Icon="box" Click="StudioWorkspace_Click" ToolTip="三维建模" Padding="3,5"/>
        <local:CadIconButton Icon="layers" Click="ModelWorkspace_Click" ToolTip="模型与楼层" Padding="3,5"/>
      </StackPanel>
      <Border x:Name="ProjectPanel" Grid.Column="1" Visibility="Collapsed" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="8">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <DockPanel><local:CadIconButton DockPanel.Dock="Right" Icon="x" Click="ProjectPanel_Click" ToolTip="收起项目浏览器"/><TextBlock Text="项目图纸" FontSize="13" FontWeight="SemiBold"/></DockPanel>
          <ListBox Grid.Row="1" x:Name="Drawings" SelectionChanged="Drawings_Changed">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Name}" ToolTip="{Binding Path}" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Grid.Row="2" Text="建筑模型" FontSize="13" FontWeight="SemiBold" Margin="3,12,0,6" />
          <ListBox Grid.Row="3" x:Name="Models" SelectionChanged="Models_Changed">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ModelPath}" />
                  <TextBlock Text="{Binding Storeys,StringFormat={}{0} 层}" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <WrapPanel Grid.Row="4" Margin="0,10,0,0">
            <Button Content="新建模型" Click="NewModel_Click" />
            <Button Content="刷新" Click="Refresh_Click" />
          </WrapPanel>
        </Grid>
      </Border>
      <TabControl Grid.Column="2" x:Name="Workspace" SelectedIndex="0">
        <TabControl.Template><ControlTemplate TargetType="TabControl"><ContentPresenter ContentSource="SelectedContent"/></ControlTemplate></TabControl.Template>
        <TabItem Header="二维 CAD">
          <local:CadWorkspace x:Name="CadEditor" />
        </TabItem>
        <TabItem Header="模型与楼层">
          <DockPanel Margin="16">
            <StackPanel DockPanel.Dock="Top">
              <TextBlock x:Name="ModelTitle" Text="新建或打开建筑模型" FontSize="22" Margin="4,0,0,10" />
              <WrapPanel>
                <Button Content="新建模型" Click="NewModel_Click" />
                <Button Content="打开模型文件" Click="OpenModel_Click" />
                <Button Content="保存模型" Click="Save_Click" />
                <Button Content="另存模型" Click="SaveCopy_Click" />
                <Button Content="进入三维建模" Click="Editor_Click" Style="{StaticResource PrimaryButton}" />
              </WrapPanel>
              <TextBlock x:Name="ModelLocation" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="4,10" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
              <WrapPanel>
                <Button Content="新增楼层" Click="AddFloor_Click" />
                <Button Content="删除楼层" Click="RemoveFloor_Click" />
                <Button Content="重新载入" Click="ReloadModel_Click" />
              </WrapPanel>
              <TextBlock x:Name="ModelDetails" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="4,10" />
            </StackPanel>
            <DataGrid x:Name="Floors" CellEditEnding="Floors_EditEnding" SelectionMode="Single">
              <DataGrid.Columns>
                <DataGridTextColumn Header="楼层 ID" Binding="{Binding Id}" IsReadOnly="True" Width="100" />
                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="标高 mm" Binding="{Binding Elevation}" Width="150" />
                <DataGridTextColumn Header="层高 mm" Binding="{Binding Height}" Width="150" />
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </TabItem>
        <TabItem Header="三维建模" />
      </TabControl>
      <Grid x:Name="StudioPanel" Grid.Column="2" Background="{StaticResource PanelBrush}">
        <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedIndex,ElementName=Workspace}" Value="2"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
        <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <local:CadIconButton Icon="save" Label="保存模型" Click="SaveStudio_Click"/>
            <local:CadIconButton Icon="layers" Label="模型与楼层" Click="ModelWorkspace_Click"/>
            <local:CadIconButton Icon="x" Label="关闭模型" Click="CloseStudio_Click"/>
          </StackPanel>
          <TextBlock x:Name="StudioTitle" Text="三维建模" TextTrimming="CharacterEllipsis" Margin="8,0"/>
        </DockPanel>
        <local:StudioHost x:Name="StudioEditor" Grid.Row="1"/>
        <TextBlock x:Name="StudioMessage" Grid.Row="1" Text="请新建或选择建筑模型。" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="20"/>
      </Grid>
    </Grid>
    <Grid Grid.Row="2" Margin="4,0">
      <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedIndex,ElementName=Workspace}" Value="1"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
      <TextBlock x:Name="Status" Text="就绪" TextWrapping="Wrap" />
    </Grid>
  </Grid>
</Window>
