<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{A0D764B9-6CC8-45B1-9F96-9BEEF91C4F7E}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>BatchPdfPublisher</RootNamespace>
    <AssemblyName>BatchPdfPublisher</AssemblyName>
    <TargetFrameworkVersion Condition="'$(TargetFrameworkVersion)' == ''">v4.8</TargetFrameworkVersion>
    <AutoCadApiPath Condition="'$(AutoCadApiPath)' == ''">C:\Program Files\Autodesk\AutoCAD 2022</AutoCadApiPath>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <FileAlignment>512</FileAlignment>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols><DebugType>full</DebugType><Optimize>false</Optimize><OutputPath>bin\Debug\</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType><Optimize>true</Optimize><OutputPath>bin\Release\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" /><Reference Include="System.Core" /><Reference Include="System.Security" /><Reference Include="System.Net.Http" /><Reference Include="System.Numerics" /><Reference Include="System.Xaml" /><Reference Include="System.Runtime.Serialization" /><Reference Include="System.Xml" /><Reference Include="System.Xml.Linq" /><Reference Include="System.IO.Compression" /><Reference Include="System.IO.Compression.FileSystem" /><Reference Include="System.Drawing" /><Reference Include="System.Windows.Forms" /><Reference Include="Microsoft.VisualBasic" />
    <Reference Include="WindowsBase" /><Reference Include="PresentationCore" /><Reference Include="PresentationFramework" />
    <Reference Include="acmgd">
      <HintPath>$(AutoCadApiPath)\acmgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="acdbmgd">
      <HintPath>$(AutoCadApiPath)\acdbmgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="accoremgd">
      <HintPath>$(AutoCadApiPath)\accoremgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="AdWindows">
      <HintPath>$(AutoCadApiPath)\AdWindows.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="PdfSharp">
      <HintPath>..\PdfSharp.dll</HintPath>
      <Private>True</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="AssemblyInfo.cs" />
    <Compile Include="..\Shared\ProductVersion.cs"><Link>Infrastructure\ProductVersion.cs</Link></Compile>
    <!-- 建筑模型的纯逻辑层：与建模程序、测试工程共用同一份源码（改这里会同时影响两边）。
         只链接插件真正用到的三个文件：模型/视图约定、JSON 读写、投影器。
         样例工厂与平面编辑逻辑只有程序用，不进插件（避免把死代码编进发布 DLL）。 -->
    <Compile Include="..\Shared\BuildingModel\ModelTypes.cs"><Link>Features\BuildingModel\Shared\ModelTypes.cs</Link></Compile>
    <Compile Include="..\Shared\BuildingModel\BuildingAxisLayout.cs"><Link>Features\BuildingModel\Shared\BuildingAxisLayout.cs</Link></Compile>
    <Compile Include="..\Shared\BuildingModel\BuildingModelJson.cs"><Link>Features\BuildingModel\Shared\BuildingModelJson.cs</Link></Compile>
    <Compile Include="..\Shared\BuildingModel\OrthographicProjector.cs"><Link>Features\BuildingModel\Shared\OrthographicProjector.cs</Link></Compile>
    <Compile Include="..\Shared\BuildingModel\OpeningElevationAdapter.cs"><Link>Features\BuildingModel\Shared\OpeningElevationAdapter.cs</Link></Compile>
    <Compile Include="..\Shared\BuildingModel\SheetComposer.cs"><Link>Features\BuildingModel\Shared\SheetComposer.cs</Link></Compile>
    <Compile Include="..\Shared\BuildingModel\StudioLaunch.cs"><Link>Features\BuildingModel\Shared\StudioLaunch.cs</Link></Compile>
    <Compile Include="..\Shared\BuildingModel\BuildingVolume.cs"><Link>Features\BuildingModel\Shared\BuildingVolume.cs</Link></Compile>
    <Compile Include="..\Shared\BuildingModel\OrthogonalWallUnion.cs"><Link>Features\BuildingModel\Shared\OrthogonalWallUnion.cs</Link></Compile>
    <Compile Include="..\Shared\BuildingModel\WallJunctionLines.cs"><Link>Features\BuildingModel\Shared\WallJunctionLines.cs</Link></Compile>
    <Compile Include="..\Shared\BuildingModel\StoreyElevationLayout.cs"><Link>Features\BuildingModel\Shared\StoreyElevationLayout.cs</Link></Compile>
    <Compile Include="..\Shared\BuildingModel\StandardStoreyLayout.cs"><Link>Features\BuildingModel\Shared\StandardStoreyLayout.cs</Link></Compile>
    <Compile Include="..\Shared\BuildingModel\StairGeometry.cs"><Link>Features\BuildingModel\Shared\StairGeometry.cs</Link></Compile>
    <Compile Include="..\Shared\BuildingModel\RoofGeometry.cs"><Link>Features\BuildingModel\Shared\RoofGeometry.cs</Link></Compile>
    <Compile Include="..\Shared\BuildingModel\VolumeRenderer.cs"><Link>Features\BuildingModel\Shared\VolumeRenderer.cs</Link></Compile>
    <Compile Include="Compatibility\Net40Polyfills.cs" />
    <Compile Include="Commands.cs" />
    <Compile Include="Infrastructure\**\*.cs" />
    <Compile Include="Shell\**\*.cs" />
    <Compile Include="Features\**\*.cs" Exclude="Features\Frames\Views\FrameRegistrationWindow.xaml.cs" />
    <Compile Include="Features\Frames\Views\FrameRegistrationWindow.xaml.cs"><DependentUpon>FrameRegistrationWindow.xaml</DependentUpon></Compile>
    <Page Include="Features\Frames\Views\FrameRegistrationWindow.xaml" />
    <Page Include="Features\BuildingModel\Views\BuildingModelChoiceWindow.xaml" />
    <Page Include="Features\BuildingModel\Views\BuildingModelBatchWindow.xaml" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\Resources\Ribbon\ios-icons.png">
      <LogicalName>Wanluo.Ribbon.IosIcons.png</LogicalName>
    </EmbeddedResource>
    <Content Include="..\ThirdParty\Pdfium\pdfium.dll">
      <Link>pdfium.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\ThirdParty\Pdfium\LICENSES\**\*">
      <Link>licenses\Pdfium\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>




