<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <OutputType>Library</OutputType>
    <RootNamespace>BatchPdfPublisher</RootNamespace>
    <AssemblyName>BatchPdfPublisher</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj\**;obj-*\**</DefaultItemExcludes>
    <AutoCadApiPath Condition="'$(AutoCadApiPath)' == ''">C:\Program Files\Autodesk\AutoCAD 2025</AutoCadApiPath>
    <UseAutoCadNuGet Condition="'$(UseAutoCadNuGet)' == '' And !Exists('$(AutoCadApiPath)\acmgd.dll')">true</UseAutoCadNuGet>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\Resources\Ribbon\ios-icons.png" LogicalName="Wanluo.Ribbon.IosIcons.png" />
    <Compile Include="..\Shared\ProductVersion.cs" Link="Infrastructure\ProductVersion.cs" />
    <!-- 建筑模型的纯逻辑层：与建模程序、测试工程共用同一份源码（只链接插件用到的三个文件）。 -->
    <Compile Include="..\Shared\BuildingModel\ModelTypes.cs" Link="Features\BuildingModel\Shared\ModelTypes.cs" />
    <Compile Include="..\Shared\BuildingModel\BuildingModelJson.cs" Link="Features\BuildingModel\Shared\BuildingModelJson.cs" />
    <Compile Include="..\Shared\BuildingModel\OrthographicProjector.cs" Link="Features\BuildingModel\Shared\OrthographicProjector.cs" />
    <Reference Include="PdfSharp" HintPath="..\PdfSharp.dll" Private="true" />
    <None Include="..\ThirdParty\Pdfium\pdfium.dll" Link="pdfium.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\ThirdParty\Pdfium\LICENSES\**\*" Link="licenses\Pdfium\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseAutoCadNuGet)' != 'true'">
    <Reference Include="acmgd" HintPath="$(AutoCadApiPath)\acmgd.dll" Private="false" />
    <Reference Include="acdbmgd" HintPath="$(AutoCadApiPath)\acdbmgd.dll" Private="false" />
    <Reference Include="accoremgd" HintPath="$(AutoCadApiPath)\accoremgd.dll" Private="false" />
    <Reference Include="AdWindows" HintPath="$(AutoCadApiPath)\AdWindows.dll" Private="false" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseAutoCadNuGet)' == 'true'">
    <PackageReference Include="AutoCAD.NET" Version="25.0.1" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>
</Project>
