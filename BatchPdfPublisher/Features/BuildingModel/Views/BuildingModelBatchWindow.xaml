<Window x:Class="BatchPdfPublisher.Views.BuildingModelBatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="模型视图落图" Width="1280" Height="790" MinWidth="650" MinHeight="440"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="#142337" Foreground="#F0F5FA" FontFamily="Microsoft YaHei UI"
        FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Surface" Color="#192B40"/>
    <SolidColorBrush x:Key="SurfaceHover" Color="#203D5B"/>
    <SolidColorBrush x:Key="BorderColor" Color="#35516D"/>
    <SolidColorBrush x:Key="Accent" Color="#087CF4"/>
    <Style x:Key="ActionButton" TargetType="Button">
      <Setter Property="MinHeight" Value="39"/>
      <Setter Property="Padding" Value="16,6"/>
      <Setter Property="Background" Value="#21384F"/>
      <Setter Property="Foreground" Value="#F0F5FA"/>
      <Setter Property="BorderBrush" Value="#41617D"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Shell" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Shell" Property="Opacity" Value="0.83"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Shell" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="TextAction" TargetType="Button" BasedOn="{StaticResource ActionButton}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Foreground" Value="#62B3FF"/>
      <Setter Property="Padding" Value="6,4"/>
      <Setter Property="MinHeight" Value="30"/>
    </Style>
    <Style x:Key="FilterButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="Padding" Value="12,4"/>
      <Setter Property="Margin" Value="0,0,7,0"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#F0F5FA"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Width="24" Height="24">
              <Border x:Name="Box" Width="21" Height="21" CornerRadius="4"
                      Background="#142337" BorderBrush="#B6C7D7" BorderThickness="1.5"/>
              <Path x:Name="Tick" Data="M 5,12 L 10,17 L 19,7" Stroke="White"
                    StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    Visibility="Collapsed"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="#087CF4"/>
                <Setter TargetName="Box" Property="BorderBrush" Value="#087CF4"/>
                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="RadioButton">
      <Setter Property="Foreground" Value="#F0F5FA"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <StackPanel Orientation="Horizontal">
              <Grid Width="25" Height="25" Margin="0,0,11,0">
                <Ellipse x:Name="Ring" Width="21" Height="21" Fill="#142337"
                         Stroke="#A7BDD0" StrokeThickness="1.5"/>
                <Ellipse x:Name="Dot" Width="9" Height="9" Fill="White" Visibility="Collapsed"/>
              </Grid>
              <ContentPresenter VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Ring" Property="Fill" Value="#087CF4"/>
                <Setter TargetName="Ring" Property="Stroke" Value="#087CF4"/>
                <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ScrollPage" TargetType="RepeatButton">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Thumb">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border Background="#55718A" CornerRadius="5" Margin="2"/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="12"/>
      <Setter Property="Background" Value="#142337"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="{TemplateBinding Background}">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPage}"/></Track.DecreaseRepeatButton>
                <Track.Thumb><Thumb/></Track.Thumb>
                <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPage}"/></Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="24,19,24,17">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="模型视图落图" FontSize="28" FontWeight="SemiBold"/>
        <TextBlock Text="选择图框，勾选要落入 CAD 的图纸和视图" Foreground="#A9C1D6" Margin="0,5,0,0"/>
      </StackPanel>
      <TextBlock x:Name="ProjectText" Grid.Column="1" VerticalAlignment="Center"
                 Foreground="#A9C1D6" TextTrimming="CharacterEllipsis" MaxWidth="300"/>
    </Grid>

    <ScrollViewer x:Name="WorkspaceScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
    <Grid x:Name="WorkspaceGrid" Margin="20,0,20,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="FrameColumn" Width="330"/>
        <ColumnDefinition x:Name="WorkspaceGap" Width="12"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border x:Name="FramePanel" Grid.Column="0" Grid.Row="0" Background="{StaticResource Surface}"
              BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="20">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="图框" FontSize="20" FontWeight="SemiBold"/>
          <StackPanel Grid.Row="1" Margin="0,17,0,0">
            <RadioButton x:Name="ProjectFrameRadio" Content="项目图框" GroupName="FrameMode" IsChecked="True" Checked="FrameMode_Changed"/>
            <RadioButton x:Name="BuiltInFrameRadio" Content="图纸自带图框" GroupName="FrameMode" Margin="0,13,0,0" Checked="FrameMode_Changed"/>
            <RadioButton x:Name="NoFrameRadio" Content="无图框" GroupName="FrameMode" Margin="0,13,0,0" Checked="FrameMode_Changed"/>
          </StackPanel>
          <Button x:Name="FrameSelectButton" Grid.Row="2" Style="{StaticResource ActionButton}"
                  HorizontalContentAlignment="Stretch" Margin="0,19,0,12" Click="FrameSelectButton_Click">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="FrameNameText" Text="选择项目图框" TextTrimming="CharacterEllipsis"/>
              <TextBlock Grid.Column="1" Text="⌄" FontSize="18" Margin="9,-5,0,0"/>
            </Grid>
          </Button>
          <Border x:Name="FramePreview" Grid.Row="3" Background="#112137" BorderBrush="#4B6581"
                  BorderThickness="1" CornerRadius="5" Padding="12" MinHeight="165">
            <Viewbox Stretch="Uniform">
              <Grid Width="280" Height="205">
                <Border BorderBrush="#C5D3DF" BorderThickness="1.3" Margin="0"/>
                <Border BorderBrush="#8CA6BB" BorderThickness="1" Margin="7"/>
                <Grid Margin="16">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="67"/></Grid.ColumnDefinitions>
                  <Canvas Width="176" Height="155" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Rectangle Canvas.Left="21" Canvas.Top="20" Width="132" Height="112" Stroke="#AFC8DA" StrokeThickness="1"/>
                    <Line X1="21" Y1="68" X2="153" Y2="68" Stroke="#AFC8DA" StrokeThickness="1"/>
                    <Line X1="76" Y1="20" X2="76" Y2="132" Stroke="#AFC8DA" StrokeThickness="1"/>
                    <Line X1="110" Y1="68" X2="110" Y2="132" Stroke="#AFC8DA" StrokeThickness="1"/>
                    <Rectangle Canvas.Left="31" Canvas.Top="32" Width="30" Height="22" Stroke="#849FB7"/>
                    <Rectangle Canvas.Left="88" Canvas.Top="31" Width="42" Height="24" Stroke="#849FB7"/>
                    <Line X1="2" Y1="6" X2="171" Y2="6" Stroke="#607D99" StrokeDashArray="3 3"/>
                    <Line X1="2" Y1="145" X2="171" Y2="145" Stroke="#607D99" StrokeDashArray="3 3"/>
                  </Canvas>
                  <Border Grid.Column="1" BorderBrush="#AFC8DA" BorderThickness="1,0,0,0" Margin="5,0,0,0">
                    <StackPanel>
                      <TextBlock Text="万落建筑" FontSize="10" FontWeight="Bold" TextAlignment="Center" Margin="0,4"/>
                      <Separator Background="#AFC8DA"/>
                      <TextBlock Text="工程名称" FontSize="8" Margin="5,10,0,0"/>
                      <TextBlock Text="图纸名称" FontSize="8" Margin="5,13,0,0"/>
                      <TextBlock Text="图号 / 比例" FontSize="8" Margin="5,13,0,0"/>
                      <TextBlock x:Name="FramePaperText" Text="A3 横向" FontSize="11" FontWeight="Bold" Margin="5,18,0,0"/>
                    </StackPanel>
                  </Border>
                </Grid>
              </Grid>
            </Viewbox>
          </Border>
          <TextBlock Grid.Row="3" Text="布局示意" FontSize="11" Foreground="#829DB6"
                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,7,0"
                     Visibility="{Binding ElementName=FramePreview, Path=Visibility}"/>
          <TextBlock x:Name="FrameHintText" Grid.Row="4" Text="规格不匹配时提示，不自动套错图框"
                     Foreground="#94B6D1" TextWrapping="Wrap" Margin="0,13,0,0"/>
        </Grid>
      </Border>

      <Border x:Name="ContentsPanel" Grid.Column="2" Grid.Row="0" Background="{StaticResource Surface}"
              BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="20">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="选择落图内容" FontSize="20" FontWeight="SemiBold"/>
          <Grid Grid.Row="1" Margin="0,14,0,13">
            <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid>
              <TextBox x:Name="SearchBox" Height="37" Background="#122339" Foreground="#F0F5FA"
                       BorderBrush="#41617D" Padding="10,7" VerticalContentAlignment="Center"
                       TextChanged="SearchBox_TextChanged" ToolTip="搜索图纸或视图名称"/>
              <TextBlock x:Name="SearchHint" Text="搜索图纸或视图名称" Foreground="#819BB3"
                         VerticalAlignment="Center" Margin="11,0,0,0" IsHitTestVisible="False"/>
            </Grid>
            <StackPanel x:Name="FilterPanel" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Content="全部" Tag="全部" Style="{StaticResource FilterButton}" Click="FilterButton_Click"/>
              <Button Content="图纸" Tag="图纸" Style="{StaticResource FilterButton}" Click="FilterButton_Click"/>
              <Button Content="平面" Tag="平面" Style="{StaticResource FilterButton}" Click="FilterButton_Click"/>
              <Button Content="立面" Tag="立面" Style="{StaticResource FilterButton}" Click="FilterButton_Click"/>
              <Button Content="剖面" Tag="剖面" Style="{StaticResource FilterButton}" Margin="0" Click="FilterButton_Click"/>
            </StackPanel>
          </Grid>
          <Grid Grid.Row="2" Background="#24394F" Height="41">
            <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="4*"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Text="名称" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="类型" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="3" Text="纸张" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="4" Text="状态" VerticalAlignment="Center"/>
          </Grid>
          <ListBox x:Name="ViewsList" Grid.Row="3" Background="#14263A" Foreground="#F0F5FA" BorderThickness="0"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template"><Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="RowBorder" Background="{TemplateBinding Background}" BorderBrush="#34516D" BorderThickness="0,0,0,1">
                      <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <DataTrigger Binding="{Binding IsChecked}" Value="True"><Setter TargetName="RowBorder" Property="Background" Value="#1D4267"/></DataTrigger>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowBorder" Property="BorderBrush" Value="#1686F7"/></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value></Setter>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Height="57">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="4*"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>
                  <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            VerticalAlignment="Center" HorizontalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="{Binding Name}" ToolTip="{Binding Name}"
                             Foreground="#F0F5FA" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Column="2" Text="{Binding KindText}" Foreground="#C5D8E9" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="3" Text="{Binding PaperText}" Foreground="#C5D8E9" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="4" Text="{Binding StatusText}" Foreground="{Binding StatusBrush}"
                             VerticalAlignment="Center"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Grid.Row="3" Text="没有匹配的视图。请调整搜索，或先在建筑模型中生成视图。"
                     Foreground="#A9C1D6" HorizontalAlignment="Center" VerticalAlignment="Center"
                     TextWrapping="Wrap" IsHitTestVisible="False" MaxWidth="360">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding ElementName=ViewsList, Path=HasItems}" Value="False">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="SelectedCountText" VerticalAlignment="Center" Foreground="#B3CDE2"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <Button Content="全选" Style="{StaticResource TextAction}" Click="SelectAllButton_Click"/>
              <TextBlock Text="/" VerticalAlignment="Center" Foreground="#829DB6" Margin="2,0"/>
              <Button Content="清空" Style="{StaticResource TextAction}" Click="ClearButton_Click"/>
              <Button Content="刷新" Style="{StaticResource TextAction}" Click="RefreshButton_Click"/>
            </StackPanel>
          </Grid>
        </Grid>
      </Border>
    </Grid>
    </ScrollViewer>

    <Grid Grid.Row="2" Background="#132136" MinHeight="74">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="落图时在 CAD 中依次指定插入点；已有内容可选择更新或另插"
                 Foreground="#A9C1D6" VerticalAlignment="Center" Margin="24,0" TextWrapping="Wrap"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
        <Button Content="取消" Style="{StaticResource ActionButton}" Width="104" Margin="0,0,10,0"
                IsCancel="True" Click="CancelButton_Click"/>
        <Button x:Name="StartButton" Content="开始落图（0 项）" Style="{StaticResource ActionButton}"
                Background="#087CF4" BorderBrush="#087CF4" MinWidth="170" IsDefault="True"
                Click="StartButton_Click"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
