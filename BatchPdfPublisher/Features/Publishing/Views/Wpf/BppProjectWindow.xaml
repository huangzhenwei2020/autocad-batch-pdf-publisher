<Window x:Class="BatchPdfPublisher.Views.BppProjectWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="项目管理" Width="1040" Height="720" MinWidth="800" MinHeight="580" Style="{DynamicResource {x:Type Window}}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="BppTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource BppCard}">
            <DockPanel>
                <TextBox x:Name="Search" DockPanel.Dock="Top" TextChanged="Search_Changed" ToolTip="搜索项目" />
                <ListBox x:Name="Projects" DisplayMemberPath="Name" SelectionChanged="Project_Changed" />
            </DockPanel>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource BppCard}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="6">
                    <TextBlock Text="项目名称" />
                    <TextBox x:Name="ProjectName" />
                    <TextBlock Text="工程文件夹" Margin="3,12,3,0" />
                    <TextBox x:Name="ProjectFolder" />
                    <WrapPanel>
                        <Button Content="选择文件夹" Click="ChooseFolder_Click" />
                        <Button Content="打开文件夹" Click="OpenFolder_Click" />
                        <Button Content="复制迁移项目" Click="Migrate_Click" />
                    </WrapPanel>
                    <WrapPanel Margin="0,12">
                        <Button Content="新建／切换项目" Click="Create_Click" Style="{StaticResource BppPrimary}" />
                        <Button Content="切换选中项目" Click="Switch_Click" />
                        <Button Content="删除项目记录" Click="Delete_Click" />
                    </WrapPanel>
                    <TextBlock Text="自动保存间隔（分钟）" />
                    <TextBox x:Name="AutoSave" Text="0" />
                    <TextBlock Text="0 使用 CAD 自动保存设置" Foreground="{StaticResource BppMuted}" Margin="6" />
                    <WrapPanel>
                        <Button Content="保存项目参数" Click="Save_Click" />
                        <Button Content="立即自动保存" Click="SaveNow_Click" />
                        <Button Content="同步自动保存文件" Click="Sync_Click" />
                    </WrapPanel>
                    <TextBlock Text="扫描空间" FontWeight="SemiBold" Margin="3,18,3,8" />
                    <CheckBox x:Name="ModelSpace" Content="扫描模型空间" />
                    <CheckBox x:Name="AllLayouts" Content="扫描全部布局" />
                    <ItemsControl x:Name="LayoutItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <WrapPanel>
                        <Button Content="保存扫描范围" Click="SaveScope_Click" />
                        <Button Content="保存当前 CAD 到工程" Click="SaveCad_Click" />
                    </WrapPanel>
                    <TextBlock x:Name="Status" TextWrapping="Wrap" Margin="6,16" />
                    <Button Content="关闭" Click="Close_Click" HorizontalAlignment="Right" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>