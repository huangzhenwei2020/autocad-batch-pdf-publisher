<Window x:Class="BatchPdfPublisher.Views.BppValidationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="发布前图框检查" Width="900" Height="560" MinWidth="700" MinHeight="400" Style="{DynamicResource {x:Type Window}}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="BppTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Text="选择问题后可以定位图框或修改登记" Margin="6,4,6,14" />
        <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="定位图框" Click="Locate_Click" />
            <Button Content="修改图框登记" Click="Edit_Click" />
            <Button Content="关闭" Click="Close_Click" />
        </WrapPanel>
        <ListBox x:Name="Issues" DisplayMemberPath="Text" MouseDoubleClick="Issues_DoubleClick" />
    </DockPanel>
</Window>