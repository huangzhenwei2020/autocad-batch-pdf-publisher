<local:BppCadWindow x:Class="BatchPdfPublisher.Views.BppCatalogWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:BatchPdfPublisher.Views" Title="插入图纸目录" Width="1180" Height="800" MinWidth="900" MinHeight="600" Style="{DynamicResource {x:Type Window}}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="BppTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource BppCard}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="6">
                    <TextBlock Text="发布子项目" FontSize="16" FontWeight="SemiBold" />
                    <TextBox x:Name="Search" TextChanged="Search_Changed" ToolTip="筛选子项目" />
                    <ItemsControl x:Name="Buildings">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Name}" IsChecked="{Binding Included}" Click="Building_Click" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <WrapPanel>
                        <Button Content="全选" Click="All_Click" />
                        <Button Content="清空" Click="None_Click" />
                    </WrapPanel>
                    <TextBlock Text="内容与列宽 mm" FontSize="16" FontWeight="SemiBold" Margin="3,18,3,8" />
                    <ItemsControl x:Name="Columns">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <TextBox DockPanel.Dock="Right" Width="105" Text="{Binding Width, UpdateSourceTrigger=LostFocus}" LostKeyboardFocus="Setting_LostFocus" />
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding Included}" Click="Building_Click" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <UniformGrid Columns="2">
                        <StackPanel>
                            <TextBlock Text="每页行数" />
                            <TextBox x:Name="Rows" Text="30" LostKeyboardFocus="Setting_LostFocus" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="行高 mm" />
                            <TextBox x:Name="RowHeight" Text="7" LostKeyboardFocus="Setting_LostFocus" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="文字高度 mm" />
                            <TextBox x:Name="TextHeight" Text="3.5" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="插入比例" />
                            <ComboBox x:Name="Scale" Text="1:1" IsEditable="True" ToolTip="支持 1:1、1:50、1:75、1:100 或纯数字。1:100 表示按 100 倍绘制目录。" />
                        </StackPanel>
                    </UniformGrid>
                    <TextBlock Text="CAD 文字样式" Margin="3,12,3,0" />
                    <ComboBox x:Name="FontName" IsEditable="True" />
                    <WrapPanel>
                        <Button Content="文字颜色" Click="Color_Click" />
                        <TextBlock x:Name="ColorName" Margin="6" />
                        <Button Content="恢复默认" Click="Defaults_Click" />
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource BppCard}">
            <DockPanel>
                <WrapPanel DockPanel.Dock="Top">
                    <Button Content="上一页" Click="Previous_Click" />
                    <TextBlock x:Name="PageLabel" Margin="12,6" />
                    <Button Content="下一页" Click="Next_Click" />
                </WrapPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock x:Name="Status" TextWrapping="Wrap" Margin="6,12" />
                    <WrapPanel HorizontalAlignment="Right">
                        <Button Content="关闭" Click="Close_Click" />
                        <Button Content="在 CAD 中插入目录" Click="Insert_Click" Style="{StaticResource BppPrimary}" />
                    </WrapPanel>
                </StackPanel>
                <DataGrid x:Name="Preview" IsReadOnly="True" CanUserSortColumns="False" />
            </DockPanel>
        </Border>
    </Grid>
</local:BppCadWindow>
