<Window x:Class="BatchPdfPublisher.Views.BppCompanyFrameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="存为公司图框" Width="520" Height="310" MinWidth="420" MinHeight="290"
        Style="{DynamicResource {x:Type Window}}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="BppTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border Style="{StaticResource BppCard}" Margin="12">
        <DockPanel Margin="8">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" IsCancel="True" />
                <Button Content="保存到公司图框库" Click="Save_Click" IsDefault="True" Style="{StaticResource BppPrimary}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="公司名称" FontWeight="SemiBold" Margin="3,0,3,4" />
                <ComboBox x:Name="CompanyName" IsEditable="True" IsTextSearchEnabled="False" />
                <TextBlock Text="选择已有公司，或输入新公司名称。" Foreground="{StaticResource BppMuted}" Margin="3,3,3,10" />
                <TextBlock x:Name="SelectedFrame" Margin="3,0,3,4" TextWrapping="Wrap" />
                <CheckBox x:Name="IncludeAll" />
                <TextBlock x:Name="Status" TextWrapping="Wrap" Margin="3,8,3,0" />
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
