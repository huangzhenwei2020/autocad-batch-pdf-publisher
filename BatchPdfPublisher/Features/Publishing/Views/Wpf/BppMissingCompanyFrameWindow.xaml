<Window x:Class="BatchPdfPublisher.Views.BppMissingCompanyFrameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="公司图框缺少模板" Width="540" SizeToContent="Height" MaxHeight="420"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{DynamicResource {x:Type Window}}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="BppTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel Margin="20">
        <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="删除公司图框" Click="Delete_Click" Foreground="#FFAB9E" />
            <Button Content="选择 DWG 补齐" Click="Choose_Click" Style="{StaticResource BppPrimary}" IsDefault="True" />
            <Button Content="取消" IsCancel="True" />
        </WrapPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="FrameTitle" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
                <TextBlock x:Name="Status" TextWrapping="Wrap" Foreground="{StaticResource BppMuted}" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
