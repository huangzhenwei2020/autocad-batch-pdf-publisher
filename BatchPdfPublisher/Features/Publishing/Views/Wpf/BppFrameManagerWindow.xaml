<Window x:Class="BatchPdfPublisher.Views.BppFrameManagerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="图框登记" Width="1100" Height="760" MinWidth="800" MinHeight="580" Style="{DynamicResource {x:Type Window}}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="BppTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource BppCard}">
            <DockPanel>
                <TextBox x:Name="Search" DockPanel.Dock="Top" ToolTip="搜索图框名称或备注" TextChanged="Search_Changed" />
                <ListBox x:Name="Frames" DisplayMemberPath="DisplayName" SelectionChanged="Frame_Changed" />
            </DockPanel>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource BppCard}">
            <DockPanel>
                <WrapPanel DockPanel.Dock="Top">
                    <Button Content="拾取登记" Click="Pick_Click" Style="{StaticResource BppPrimary}" />
                    <Button Content="创建图框" Click="Create_Click" />
                    <Button Content="修改信息" Click="Edit_Click" />
                    <Button Content="保存图框库" Click="Save_Click" />
                    <Button Content="删除登记" Click="Delete_Click" />
                </WrapPanel>
                <Button DockPanel.Dock="Bottom" Content="关闭" Click="Close_Click" HorizontalAlignment="Right" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <TextBlock x:Name="Details" FontSize="15" TextWrapping="Wrap" />
                        <TextBlock Text="属性映射与默认值" FontSize="17" FontWeight="SemiBold" Margin="0,24,0,12" />
                        <DataGrid x:Name="Mapping" IsReadOnly="True" MinHeight="210">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="用途" Binding="{Binding Name}" Width="130" />
                                <DataGridTextColumn Header="CAD 属性标签" Binding="{Binding Tag}" Width="160" />
                                <DataGridTextColumn Header="默认值" Binding="{Binding Value}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="Range" TextWrapping="Wrap" Margin="0,18" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>