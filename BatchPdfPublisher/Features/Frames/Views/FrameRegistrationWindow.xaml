<Window x:Class="BatchPdfPublisher.Views.FrameRegistrationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="登记图框" Width="700" Height="650" MinWidth="620" MinHeight="520" WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" Background="#F3F6FA">
  <Window.Resources>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#172033"/></Style>
    <Style TargetType="TextBox"><Setter Property="Foreground" Value="#172033"/><Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#9AA8BA"/><Setter Property="Padding" Value="4,2"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#172033"/><Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#9AA8BA"/></Style>
  </Window.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="图框登记信息" FontWeight="SemiBold" FontSize="16"/>
    <TextBlock Grid.Row="1" Text="图块名称" Margin="0,14,0,0"/>
    <TextBox Grid.Row="1" Grid.Column="1" x:Name="BlockNameBox" Margin="0,10,0,0" IsReadOnly="True" Background="#E7EDF4"/>
    <TextBlock Grid.Row="2" Text="用户备注" Margin="0,10,0,0"/>
    <TextBox Grid.Row="2" Grid.Column="1" x:Name="NoteBox" Margin="0,6,0,0" ToolTip="例如：建筑施工图标准图框"/>
    <TextBlock Grid.Row="3" Text="智能检测" Margin="0,10,0,0"/>
    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="MeasuredSizeText" Margin="0,10,0,0" Foreground="#526273" TextWrapping="Wrap"/>

    <TextBlock Grid.Row="4" Text="纸张设置" Margin="0,12,0,0"/>
    <WrapPanel Grid.Row="4" Grid.Column="1" Margin="0,8,0,0">
      <TextBlock Text="规格" VerticalAlignment="Center" Margin="0,0,5,0"/>
      <ComboBox x:Name="PaperSizeBox" Width="72" SelectionChanged="PaperSizeBox_SelectionChanged"><ComboBoxItem Content="A0"/><ComboBoxItem Content="A1"/><ComboBoxItem Content="A2"/><ComboBoxItem Content="A3"/><ComboBoxItem Content="A4"/></ComboBox>
      <TextBlock Text="加长" VerticalAlignment="Center" Margin="12,0,5,0"/>
      <ComboBox x:Name="ExtensionBox" Width="90" IsEditable="True"><ComboBoxItem Content="无加长"/><ComboBoxItem Content="1/4"/><ComboBoxItem Content="1/2"/><ComboBoxItem Content="3/4"/><ComboBoxItem Content="1"/><ComboBoxItem Content="5/4"/><ComboBoxItem Content="3/2"/><ComboBoxItem Content="7/4"/><ComboBoxItem Content="2"/><ComboBoxItem Content="9/4"/><ComboBoxItem Content="5/2"/><ComboBoxItem Content="3"/><ComboBoxItem Content="7/2"/></ComboBox>
      <TextBlock Text="方向" VerticalAlignment="Center" Margin="12,0,5,0"/>
      <ComboBox x:Name="OrientationBox" Width="72"><ComboBoxItem Content="横向"/><ComboBoxItem Content="纵向"/></ComboBox>
    </WrapPanel>

    <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Text="属性映射与默认值" Margin="0,18,0,4" FontWeight="SemiBold"/>
    <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Text="选择属性标签时自动读取当前值；选择“不读取”时使用右侧手工值。" Margin="0,40,0,6" Foreground="#526273"/>
    <Grid Grid.Row="6" Grid.ColumnSpan="2">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="220"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <TextBlock Grid.Column="1" Text="属性标签" FontWeight="SemiBold"/><TextBlock Grid.Column="3" Text="检测值 / 手工默认值" FontWeight="SemiBold"/>
      <TextBlock Grid.Row="1" Text="子项目名称" Margin="0,9,0,0"/><ComboBox Grid.Row="1" Grid.Column="1" x:Name="BuildingTagBox" Margin="0,5,0,0" SelectionChanged="TagBox_SelectionChanged"/><TextBox Grid.Row="1" Grid.Column="3" x:Name="BuildingValueBox" Margin="0,5,0,0"/>
      <TextBlock Grid.Row="2" Text="图号" Margin="0,9,0,0"/><ComboBox Grid.Row="2" Grid.Column="1" x:Name="SheetNumberTagBox" Margin="0,5,0,0" SelectionChanged="TagBox_SelectionChanged"/><TextBox Grid.Row="2" Grid.Column="3" x:Name="SheetNumberValueBox" Margin="0,5,0,0"/>
      <TextBlock Grid.Row="3" Text="图名" Margin="0,9,0,0"/><ComboBox Grid.Row="3" Grid.Column="1" x:Name="SheetNameTagBox" Margin="0,5,0,0" SelectionChanged="TagBox_SelectionChanged"/><TextBox Grid.Row="3" Grid.Column="3" x:Name="SheetNameValueBox" Margin="0,5,0,0"/>
      <TextBlock Grid.Row="4" Text="打印比例" Margin="0,9,0,0"/><ComboBox Grid.Row="4" Grid.Column="1" x:Name="PrintScaleTagBox" Margin="0,5,0,0" SelectionChanged="TagBox_SelectionChanged"/><TextBox Grid.Row="4" Grid.Column="3" x:Name="PrintScaleValueBox" Margin="0,5,0,0" ToolTip="例如 1:100"/>
    </Grid>

    <DockPanel Grid.Row="7" Grid.ColumnSpan="2" Margin="0,16,0,0">
      <Button Content="扫描工程 CAD" Width="110" Click="ScanProject_Click" ToolTip="检查当前工程所有 DWG 中的同名图块版本和重复属性 TAG；未打开文件采用后台只读扫描。"/>
      <TextBlock x:Name="ProjectScanText" Margin="12,3,0,0" Foreground="#526273" TextWrapping="Wrap" Text="保存登记前将自动检查工程中的同名图块。"/>
    </DockPanel>
    <StackPanel Grid.Row="8" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="取消" Width="75" IsCancel="True" Margin="0,0,8,0"/>
      <Button Content="保存登记" Width="90" IsDefault="True" Click="Save_Click" Background="#D8E7F7" Foreground="#172033"/>
    </StackPanel>
  </Grid>
  </ScrollViewer>
</Window>
