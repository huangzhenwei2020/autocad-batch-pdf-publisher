<UserControl x:Class="BatchPdfPublisher.Views.PublisherControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" MinWidth="760" MinHeight="460" Background="#F3F6FA">
  <UserControl.Resources>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#18212F"/></Style>
    <Style TargetType="Button"><Setter Property="Foreground" Value="#172033"/><Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#9AA8BA"/><Setter Property="Padding" Value="8,4"/></Style>
    <Style TargetType="ListBox"><Setter Property="Foreground" Value="#172033"/><Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#9AA8BA"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#172033"/><Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#9AA8BA"/></Style>
    <Style TargetType="TextBox"><Setter Property="Foreground" Value="#172033"/><Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#9AA8BA"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#172033"/></Style>
    <Style TargetType="DataGrid"><Setter Property="Foreground" Value="#172033"/><Setter Property="Background" Value="#FFFFFF"/><Setter Property="RowBackground" Value="#FFFFFF"/><Setter Property="AlternatingRowBackground" Value="#EEF3F8"/><Setter Property="BorderBrush" Value="#9AA8BA"/></Style>
    <Style TargetType="DataGridColumnHeader"><Setter Property="Foreground" Value="#172033"/><Setter Property="Background" Value="#DCE5EF"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  </UserControl.Resources>
  <Grid Margin="14" Background="#F3F6FA">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="0,0,0,12"><TextBlock Text="批量 PDF 发布" FontSize="18" FontWeight="SemiBold" DockPanel.Dock="Left"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="1. 拾取图框登记" Command="{Binding RegisterFrameCommand}" Margin="4,0" FontWeight="SemiBold"/><Button Content="2. 扫描当前图纸" Command="{Binding ScanCommand}" Margin="4,0"/><Button Content="发布 PDF" Margin="4,0" IsEnabled="False" ToolTip="PDF 发布引擎将在下一开发阶段接入"/></StackPanel></DockPanel>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Margin="0,0,12,0"><TextBlock Text="楼栋" FontWeight="SemiBold" Margin="0,0,0,5"/><ListBox ItemsSource="{Binding Buildings}" SelectedItem="{Binding SelectedBuilding}" Height="175"/><TextBlock Text="已登记图框" FontWeight="SemiBold" Margin="0,16,0,5"/><ListBox ItemsSource="{Binding Frames}" SelectedItem="{Binding SelectedFrame}" DisplayMemberPath="DisplayName" Height="125"/><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button Content="拾取登记" Command="{Binding RegisterFrameCommand}" Margin="0,0,4,0"/><Button Content="删除" Command="{Binding RemoveFrameCommand}"/></StackPanel><Button Content="保存图框库" Command="{Binding SaveFrameLibraryCommand}" Margin="0,7,0,0"/></StackPanel>
      <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><TextBlock Text="图纸列表（读取图块属性）" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="上移" Command="{Binding MoveUpCommand}" Margin="3,0"/><Button Content="下移" Command="{Binding MoveDownCommand}" Margin="3,0"/></StackPanel></DockPanel><DataGrid Grid.Row="1" ItemsSource="{Binding SheetView}" SelectedItem="{Binding SelectedSheet}" AutoGenerateColumns="False" CanUserAddRows="False" AlternationCount="2" Margin="0,7,0,7"><DataGrid.Columns><DataGridTextColumn Header="序" Binding="{Binding Order}" Width="35"/><DataGridTextColumn Header="图号" Binding="{Binding SheetNumber}" Width="90"/><DataGridTextColumn Header="图名" Binding="{Binding SheetName}" Width="*"/><DataGridTextColumn Header="图框" Binding="{Binding FrameDisplay}" Width="70"/><DataGridTextColumn Header="打印比例" Binding="{Binding PrintScale}" Width="75"/><DataGridTextColumn Header="来源文件" Binding="{Binding SourceFile}" Width="120"/></DataGrid.Columns></DataGrid><TextBlock Grid.Row="2" Text="{Binding Status}" TextWrapping="Wrap" Foreground="#526273"/></Grid>
      <StackPanel Grid.Column="2" Margin="12,0,0,0"><TextBlock Text="输出设置" FontWeight="SemiBold"/><TextBlock Text="打印样式" Margin="0,10,0,3"/><ComboBox SelectedIndex="0"><ComboBoxItem Content="monochrome.ctb（黑白）"/><ComboBoxItem Content="acad.ctb（彩色）"/></ComboBox><TextBlock Text="白边 / 出血位" Margin="0,10,0,3"/><ComboBox SelectedIndex="0"><ComboBoxItem Content="自动适配"/><ComboBoxItem Content="无白边（满幅）"/><ComboBoxItem Content="保留 3 mm 白边"/></ComboBox><TextBlock Text="输出目录" Margin="0,10,0,3"/><TextBox Text="D:\PDF输出"/><CheckBox Content="每栋楼生成一个 PDF" IsChecked="True" Margin="0,12,0,0"/></StackPanel>
    </Grid>
    <TextBlock Grid.Row="2" Margin="0,10,0,0" Foreground="#526273" Text="使用顺序：先“拾取图框登记” → 填写纸张规格与加长比例 → 扫描图纸。加长示例：A3+1/4、A3+1/2。"/>
  </Grid>
</UserControl>
