<UserControl x:Class="BatchPdfPublisher.Views.PublisherControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" MinWidth="760" MinHeight="460" Background="#F3F6FA">
  <UserControl.Resources>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#18212F"/></Style>
    <Style TargetType="Button"><Setter Property="Foreground" Value="#172033"/><Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#9AA8BA"/><Setter Property="Padding" Value="8,4"/></Style>
    <Style TargetType="ListBox"><Setter Property="Foreground" Value="#172033"/><Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#9AA8BA"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#172033"/><Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#9AA8BA"/></Style>
    <Style TargetType="TextBox"><Setter Property="Foreground" Value="#172033"/><Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#9AA8BA"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#172033"/></Style>
    <Style TargetType="DataGrid"><Setter Property="Foreground" Value="#172033"/><Setter Property="Background" Value="#FFFFFF"/><Setter Property="RowBackground" Value="#FFFFFF"/><Setter Property="AlternatingRowBackground" Value="#EEF3F8"/><Setter Property="BorderBrush" Value="#9AA8BA"/></Style>
    <Style TargetType="DataGridColumnHeader"><Setter Property="Foreground" Value="#172033"/><Setter Property="Background" Value="#DCE5EF"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  </UserControl.Resources>
  <Grid Margin="14" Background="#F3F6FA">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="0,0,0,12"><TextBlock Text="批量 PDF 发布" FontSize="18" FontWeight="SemiBold" DockPanel.Dock="Left"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="1. 拾取图框登记" Command="{Binding RegisterFrameCommand}" Margin="4,0" FontWeight="SemiBold"/><Button Content="2. 扫描当前图纸" Command="{Binding ScanCommand}" Margin="4,0"/><Button Content="发布 PDF" Margin="4,0" IsEnabled="False" ToolTip="PDF 发布引擎将在下一开发阶段接入"/></StackPanel></DockPanel>
    <Border Grid.Row="1" Background="#E7EDF4" BorderBrush="#B7C4D2" BorderThickness="1" Padding="8" Margin="0,0,0,10"><DockPanel><TextBlock Text="当前项目" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/><ComboBox ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" DisplayMemberPath="Name" Width="160"/><TextBox Text="{Binding NewProjectName, UpdateSourceTrigger=PropertyChanged}" Width="140" Margin="10,0,4,0" ToolTip="输入新项目名称"/><Button Content="新建项目" Command="{Binding NewProjectCommand}" Margin="0,0,4,0"/><Button Content="保存项目参数" Command="{Binding SaveProjectCommand}"/></DockPanel></Border>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Margin="0,0,12,0"><TextBlock Text="楼栋" FontWeight="SemiBold" Margin="0,0,0,5"/><ListBox ItemsSource="{Binding Buildings}" SelectedItem="{Binding SelectedBuilding}" Height="150"/><TextBlock Text="已登记图框（双击修改）" FontWeight="SemiBold" Margin="0,16,0,5"/><ListBox x:Name="FramesList" ItemsSource="{Binding Frames}" SelectedItem="{Binding SelectedFrame}" Height="155" MouseDoubleClick="FramesList_MouseDoubleClick"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="3"><TextBlock Text="{Binding BlockName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock FontSize="11" Foreground="#526273"><Run Text="{Binding PaperDisplay}"/><Run Text="  "/><Run Text="{Binding PaperOrientation}"/><Run Text="  "/><Run Text="{Binding Note}"/></TextBlock></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button Content="拾取登记" Command="{Binding RegisterFrameCommand}" Margin="0,0,4,0"/><Button Content="修改" Command="{Binding EditFrameCommand}" Margin="0,0,4,0"/><Button Content="删除" Command="{Binding RemoveFrameCommand}"/></StackPanel><Button Content="保存图框库" Command="{Binding SaveFrameLibraryCommand}" Margin="0,7,0,0"/></StackPanel>
      <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><TextBlock Text="图纸列表（字段可手工修改；选中后在 CAD 中预览范围）" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="上移" Command="{Binding MoveUpCommand}" Margin="3,0"/><Button Content="下移" Command="{Binding MoveDownCommand}" Margin="3,0"/></StackPanel></DockPanel><DataGrid Grid.Row="1" ItemsSource="{Binding SheetView}" SelectedItem="{Binding SelectedSheet}" AutoGenerateColumns="False" CanUserAddRows="False" AlternationCount="2" Margin="0,7,0,7"><DataGrid.Columns><DataGridTextColumn Header="序" Binding="{Binding Order}" Width="35" IsReadOnly="True"/><DataGridTextColumn Header="楼栋" Binding="{Binding Building}" Width="75"/><DataGridTextColumn Header="图号" Binding="{Binding SheetNumber}" Width="90"/><DataGridTextColumn Header="图名" Binding="{Binding SheetName}" Width="*"/><DataGridTextColumn Header="图框" Binding="{Binding FrameDisplay}" Width="70" IsReadOnly="True"/><DataGridTextColumn Header="方向" Binding="{Binding PaperOrientation}" Width="55"/><DataGridTextColumn Header="打印比例" Binding="{Binding PrintScale}" Width="75"/><DataGridTextColumn Header="来源文件" Binding="{Binding SourceFile}" Width="120" IsReadOnly="True"/></DataGrid.Columns></DataGrid><TextBlock Grid.Row="2" Text="{Binding Status}" TextWrapping="Wrap" Foreground="#526273"/></Grid>
      <StackPanel Grid.Column="2" Margin="12,0,0,0"><TextBlock Text="输出设置" FontWeight="SemiBold"/><TextBlock Text="打印样式" Margin="0,10,0,3"/><ComboBox SelectedValue="{Binding PlotStyle, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content"><ComboBoxItem Content="monochrome.ctb"/><ComboBoxItem Content="acad.ctb"/></ComboBox><TextBlock Text="白边 / 出血位（单位：mm）" Margin="0,10,0,3"/><ComboBox SelectedValue="{Binding MarginMode, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content"><ComboBoxItem Content="自动适配"/><ComboBoxItem Content="无白边（满幅）"/><ComboBoxItem Content="保留 3 mm 白边"/></ComboBox><TextBlock Text="输出目录" Margin="0,10,0,3"/><TextBox Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}"/><CheckBox Content="每栋楼生成一个 PDF" IsChecked="{Binding MergeByBuilding}" Margin="0,12,0,0"/></StackPanel>
    </Grid>
    <TextBlock Grid.Row="3" Margin="0,10,0,0" Foreground="#526273" Text="项目会分别保存图框登记、属性映射、纸张设置和输出参数；切换项目即可恢复对应配置。"/>
  </Grid>
</UserControl>
