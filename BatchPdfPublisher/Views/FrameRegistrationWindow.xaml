<Window x:Class="BatchPdfPublisher.Views.FrameRegistrationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="登记图框" Width="480" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F3F6FA">
  <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="115"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="已拾取图框图块" FontWeight="SemiBold" FontSize="16" Foreground="#172033"/><TextBlock Grid.Row="1" Text="图块名称" Margin="0,14,0,0" Foreground="#172033"/><TextBox Grid.Row="1" Grid.Column="1" x:Name="BlockNameBox" Margin="0,10,0,0" IsReadOnly="True" Background="#E7EDF4" Foreground="#172033"/>
    <TextBlock Grid.Row="2" Text="检测尺寸" Margin="0,10,0,0" Foreground="#172033"/><TextBlock Grid.Row="2" Grid.Column="1" x:Name="MeasuredSizeText" Margin="0,10,0,0" Foreground="#526273"/>
    <TextBlock Grid.Row="3" Text="纸张 / 加长" Margin="0,10,0,0" Foreground="#172033"/><StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0"><ComboBox x:Name="PaperSizeBox" Width="110" Foreground="#172033"><ComboBoxItem Content="A0"/><ComboBoxItem Content="A1"/><ComboBoxItem Content="A2"/><ComboBoxItem Content="A3"/></ComboBox><TextBlock Text="+" Margin="10,3" Foreground="#172033"/><ComboBox x:Name="ExtensionBox" Width="110" Foreground="#172033"><ComboBoxItem Content="无加长"/><ComboBoxItem Content="1/4"/><ComboBoxItem Content="1/2"/></ComboBox></StackPanel>
    <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Text="选择该图框中每个属性标签对应的内容（可留空）：" Margin="0,16,0,5" Foreground="#172033" FontWeight="SemiBold"/>
    <Grid Grid.Row="5" Grid.ColumnSpan="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="115"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="楼栋" Foreground="#172033"/><ComboBox Grid.Column="1" x:Name="BuildingTagBox" Foreground="#172033"/><TextBlock Grid.Row="1" Text="图号" Margin="0,7,0,0" Foreground="#172033"/><ComboBox Grid.Row="1" Grid.Column="1" x:Name="SheetNumberTagBox" Margin="0,5,0,0" Foreground="#172033"/><TextBlock Grid.Row="2" Text="图名" Margin="0,7,0,0" Foreground="#172033"/><ComboBox Grid.Row="2" Grid.Column="1" x:Name="SheetNameTagBox" Margin="0,5,0,0" Foreground="#172033"/><TextBlock Grid.Row="3" Text="打印比例" Margin="0,7,0,0" Foreground="#172033"/><ComboBox Grid.Row="3" Grid.Column="1" x:Name="PrintScaleTagBox" Margin="0,5,0,0" Foreground="#172033"/></Grid>
    <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Content="取消" Width="75" IsCancel="True" Margin="0,0,8,0"/><Button Content="保存登记" Width="90" IsDefault="True" Click="Save_Click" Background="#D8E7F7" Foreground="#172033"/></StackPanel>
  </Grid>
</Window>
